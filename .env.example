# GEMINI_API_KEY: Required for Gemini AI API calls (fact-preserving rewriting, conservative ad detection).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""

# APP_URL: The public URL where this server is hosted (must not be localhost in production).
# Telegram inline keyboard buttons and X OAuth callbacks require this public URL.
# Production Render URL: https://tele-to-x-bot.onrender.com (use http://localhost:3000 only for local dev)
APP_URL="https://tele-to-x-bot.onrender.com"

# TELEGRAM_BOT_TOKEN: Telegram Bot token obtained from @BotFather.
# Required for real Telegram Bot polling/webhooks and sending channel messages.
TELEGRAM_BOT_TOKEN=""

# ADMIN_KEY: Secret key required to access the protected Admin Panel.
# Set a strong secret key. Never leave this empty in production.
ADMIN_KEY=""

# MONGODB_URI: MongoDB connection string for persistent data storage.
# (e.g. mongodb+srv://user:pass@cluster.mongodb.net/x2telegram?retryWrites=true&w=majority)
# If omitted, the server automatically persists to data/db.json locally.
MONGODB_URI=""

# X (Twitter) API & OAuth 2.0 Credentials:
# TWITTER_CLIENT_ID & TWITTER_CLIENT_SECRET: From Twitter Developer Portal for OAuth 2.0 User Context posting.
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""

# TWITTER_BEARER_TOKEN: Twitter API v2 Bearer Token for official tweet monitoring.
TWITTER_BEARER_TOKEN=""

# Optional Bridge Configuration (can also be configured via Admin Dashboard):
X_SOURCE_HANDLE=""
TELEGRAM_CHANNEL_ID=""

